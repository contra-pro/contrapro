-- DRAFT GATE 4 ONLY. PRIVILEGED ADMINISTRATIVE RLS BYPASS, NOT RLS-ENFORCED CLEANUP.
-- Exact IDs come from independently reconciled private cohort manifest, never guesses.
-- Auth users are NOT deleted here. No CASCADE, policy/role change or business deletion.
BEGIN ISOLATION LEVEL SERIALIZABLE;
SET LOCAL search_path=pg_catalog;
SET LOCAL statement_timeout='5000ms';
SET LOCAL lock_timeout='2000ms';
SET LOCAL idle_in_transaction_session_timeout='10000ms';
-- Short administrative table locks prevent new FK/rule/trigger definitions and
-- concurrent identity writes while checking/deleting; may briefly block other Dev writes.
LOCK TABLE identity.users,identity.supabase_users IN SHARE ROW EXCLUSIVE MODE;
DO $cleanup$
DECLARE subjects uuid[] := ARRAY['{{A}}'::uuid,'{{B}}'::uuid,'{{U}}'::uuid];
 canonical_a uuid := {{CANONICAL_A}}; canonical_b uuid := {{CANONICAL_B}};
 auth_present boolean[] := ARRAY[{{AUTH_A}},{{AUTH_B}},{{AUTH_U}}];
 expected integer := {{EXPECTED}}; affected integer; idx integer;
BEGIN
 IF session_user<>'postgres' OR current_user<>'postgres' OR current_database()<>'postgres'
 OR current_setting('server_version_num')::integer NOT BETWEEN 170000 AND 179999
 OR NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=current_user AND (rolsuper OR rolbypassrls))
 OR to_regprocedure('public.contratpro_a02_fixture_provision()') IS NOT NULL
 OR EXISTS(SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
   WHERE n.nspname='public' AND p.proname='contratpro_a02_fixture_provision')
 OR has_function_privilege('authenticated','public.contratpro_provision_identity()','EXECUTE')
 THEN RAISE EXCEPTION 'A02 cleanup authority/boundary mismatch'; END IF;
 -- Refuse unknown FK dependencies, cascades, deferred constraints, custom triggers/rules.
 IF (SELECT count(*) FROM pg_constraint WHERE contype='f' AND confrelid='identity.users'::regclass)<>4
 OR (SELECT count(DISTINCT conrelid) FROM pg_constraint WHERE contype='f' AND confrelid='identity.users'::regclass)<>4
 OR EXISTS(SELECT 1 FROM pg_constraint c WHERE c.contype='f' AND c.confrelid='identity.users'::regclass
   AND (c.confdeltype<>'r' OR c.condeferrable OR NOT c.convalidated OR cardinality(c.conkey)<>1 OR cardinality(c.confkey)<>1
     OR NOT EXISTS(SELECT 1 FROM pg_attribute a WHERE a.attrelid=c.confrelid AND a.attnum=c.confkey[1] AND a.attname='id')
     OR NOT EXISTS(SELECT 1 FROM pg_attribute a WHERE a.attrelid=c.conrelid AND a.attnum=c.conkey[1]
       AND ((c.conrelid='identity.supabase_users'::regclass AND a.attname='user_id')
         OR (c.conrelid='tenancy.memberships'::regclass AND a.attname='user_id')
         OR (c.conrelid='tenancy.agencies'::regclass AND a.attname='created_by_user_id')
         OR (c.conrelid='tenancy.clients'::regclass AND a.attname='created_by_user_id')))))
 OR EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid IN ('identity.users'::regclass,'identity.supabase_users'::regclass) AND NOT tgisinternal)
 OR EXISTS(SELECT 1 FROM pg_rewrite WHERE ev_class IN ('identity.users'::regclass,'identity.supabase_users'::regclass))
 THEN RAISE EXCEPTION 'A02 unexpected dependency'; END IF;
 FOR idx IN 1..3 LOOP
   IF EXISTS(SELECT 1 FROM auth.users WHERE id=subjects[idx]) IS DISTINCT FROM auth_present[idx]
   THEN RAISE EXCEPTION 'A02 Auth reconciliation mismatch'; END IF;
 END LOOP;
 PERFORM id FROM identity.users WHERE id IN (canonical_a,canonical_b) FOR UPDATE;
 IF EXISTS(SELECT 1 FROM identity.users WHERE id IN (canonical_a,canonical_b) AND state<>'active')
 OR (SELECT count(*) FROM identity.users WHERE id IN (canonical_a,canonical_b))<>expected
 OR (SELECT count(*) FROM identity.supabase_users WHERE supabase_user_id=ANY(subjects) OR user_id IN (canonical_a,canonical_b))<>expected
 OR (canonical_a IS NOT NULL AND NOT EXISTS(SELECT 1 FROM identity.supabase_users WHERE supabase_user_id=subjects[1] AND user_id=canonical_a))
 OR (canonical_b IS NOT NULL AND NOT EXISTS(SELECT 1 FROM identity.supabase_users WHERE supabase_user_id=subjects[2] AND user_id=canonical_b))
 OR EXISTS(SELECT 1 FROM identity.supabase_users WHERE supabase_user_id=subjects[3])
 OR EXISTS(SELECT 1 FROM tenancy.memberships WHERE user_id IN (canonical_a,canonical_b))
 OR EXISTS(SELECT 1 FROM tenancy.agencies WHERE created_by_user_id IN (canonical_a,canonical_b))
 OR EXISTS(SELECT 1 FROM tenancy.clients WHERE created_by_user_id IN (canonical_a,canonical_b))
 THEN RAISE EXCEPTION 'A02 fixture/dependency mismatch'; END IF;
 DELETE FROM identity.supabase_users WHERE
   (supabase_user_id=subjects[1] AND user_id=canonical_a) OR (supabase_user_id=subjects[2] AND user_id=canonical_b);
 GET DIAGNOSTICS affected=ROW_COUNT;
 IF affected<>expected THEN RAISE EXCEPTION 'A02 mapping count mismatch'; END IF;
 DELETE FROM identity.users WHERE id IN (canonical_a,canonical_b);
 GET DIAGNOSTICS affected=ROW_COUNT;
 IF affected<>expected THEN RAISE EXCEPTION 'A02 canonical count mismatch'; END IF;
END;
$cleanup$;
COMMIT;
