# PLACEHOLDERS ONLY. Copy outside the checkout; inject per service via a secret store.
CONTRATPRO_A5_VERIFIED=false
CONTRATPRO_MAINTENANCE_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_SECRET
CONTRATPRO_MAINTENANCE_GATEWAY_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_SECRET
CONTRATPRO_WORKER_ORIGIN=https://private-app.example.invalid
CONTRATPRO_WORKER_CONCURRENCY=1
CONTRATPRO_WORKER_POLL_MS=5000
CONTRATPRO_STORAGE_CLEANUP_VERIFIED=false
CONTRATPRO_MAINTENANCE_STORAGE_SERVICE_KEY=INJECT_ONLY_IF_CLEANUP_EXPLICITLY_AUTHORIZED
CONTRATPRO_DELIVERY_VERIFIED=false
CONTRATPRO_RESEND_VERIFIED=false
CONTRATPRO_SHEETS_VERIFIED=false
CONTRATPRO_SIGNING_VERIFIED=false
CONTRATPRO_DOCUMENTS_VERIFIED=false
CONTRATPRO_A3_VERIFIED=false
CONTRATPRO_DELIVERY_KEY_ID=REVIEWED_ACTIVE_VERSION
CONTRATPRO_DELIVERY_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_AEAD_KEY
CONTRATPRO_DELIVERY_DERIVATION_KEY=REPLACE_WITH_DIFFERENT_STABLE_64_HEX_KEY
CONTRATPRO_DELIVERY_HISTORICAL_KEYS={}
CONTRATPRO_SHEETS_KEY_ID=REVIEWED_ACTIVE_VERSION
CONTRATPRO_SHEETS_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_AEAD_KEY
CONTRATPRO_SHEETS_HISTORICAL_KEYS={}
CONTRATPRO_DOCUMENT_FONT_PATH=/run/fonts/approved-arabic-font.ttf
# Other existing module-specific keys remain required when their gate is enabled.
# Worker container needs only A5 gate, access secret, origin, concurrency and poll.
# App container needs backend/public Auth settings, gateway and enabled task settings.
