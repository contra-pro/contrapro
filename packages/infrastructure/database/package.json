{
  "name": "@contratpro/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:sql": "vitest run tests/sql-contract.test.ts tests/schema-contract.test.ts",
    "test:runner": "vitest run tests/migration-",
    "migrations:plan": "node scripts/plan.ts",
    "migrations:apply": "node scripts/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "libpg-query": "18.2.4",
    "pgsql-parser": "18.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
